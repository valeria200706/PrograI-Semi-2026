From 4e9de51021594b8548c875546e79a6116dae0891 Mon Sep 17 00:00:00 2001
From: Luis Hernandez <sarco_luis@hotmail.com>
Date: Mon, 24 Aug 2026 10:17:23 -0600
Subject: [PATCH] Encontrar la desviacion estandar

---
 .../miPrimeaAplicacion/Form1.cs               |   6 +++++-
 .../bin/Debug/miPrimeaAplicacion.exe          | Bin 10752 -> 10752 bytes
 .../bin/Debug/miPrimeaAplicacion.pdb          | Bin 38400 -> 38400 bytes
 .../obj/Debug/miPrimeaAplicacion.exe          | Bin 10752 -> 10752 bytes
 .../obj/Debug/miPrimeaAplicacion.pdb          | Bin 38400 -> 38400 bytes
 5 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/miPrimeaAplicacion/miPrimeaAplicacion/Form1.cs b/miPrimeaAplicacion/miPrimeaAplicacion/Form1.cs
index ccea99f..bc62900 100644
--- a/miPrimeaAplicacion/miPrimeaAplicacion/Form1.cs
+++ b/miPrimeaAplicacion/miPrimeaAplicacion/Form1.cs
@@ -21,8 +21,11 @@ double media(double[] serie){
             double media = suma / serie.Length;
             return media;
         }
+        double varianza(double[] serie, double media) {
+            return serie.Average(n => Math.Pow(n - media, 2));
+        }
         double desviacionTipica(double[] serie, double media){
-            return Math.Sqrt(serie.Average(n => Math.Pow(n - media, 2)));
+            return Math.Sqrt(varianza(serie, media));
         }
         double armonica(double[] serie) {
             int n = serie.Length;
@@ -37,6 +40,7 @@ private void btnProcesar_Click(object sender, EventArgs e)
             double m = media(miSerie);
 
             ltsValores.Items.Add("La media es: " + m);
+            ltsValores.Items.Add("La desviacion estandar: " + varianza(miSerie, m));
             ltsValores.Items.Add("La desviacion tipica: "+ desviacionTipica(miSerie, m));
             ltsValores.Items.Add("La media armonica: " + armonica(miSerie));
         }
