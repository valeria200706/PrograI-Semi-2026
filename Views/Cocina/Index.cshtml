@model IEnumerable<BumburysRestaurant.Models.Ordene>
@{
    ViewData["Title"] = "Monitor de Cocina";
}

<!-- Refrescar la página automáticamente cada 30 segundos -->
<meta http-equiv="refresh" content="30">

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div class="d-flex align-items-center">
        <h2 class="mb-0 fw-bold" style="color: #b30000;"><i class="bi bi-fire me-2"></i>Monitor de Cocina</h2>
    </div>
    <div>
        <span class="badge bg-dark fs-6 shadow-sm py-2 px-3">
            <i class="bi bi-arrow-clockwise me-1"></i> Actualización Auto (30s)
        </span>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var orden in Model)
        {
            // Determinar colores basados en el estado
            string bordeTarjeta = orden.IdEstado == 1 ? "border-danger" : "border-warning";
            string fondoHeader = orden.IdEstado == 1 ? "bg-danger text-white" : "bg-warning text-dark";
            string iconoEstado = orden.IdEstado == 1 ? "bi-exclamation-circle-fill" : "bi-arrow-repeat";

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm @bordeTarjeta" style="border-width: 2px;">
                    <div class="card-header @fondoHeader d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0 fw-bold">Orden #@orden.IdOrden</h5>
                        <span class="small fw-bold"><i class="bi @iconoEstado me-1"></i> @(orden.IdEstado == 1 ? "Pendiente" : "En Preparación")</span>
                    </div>
                    <div class="card-body bg-light">
                        <p class="small text-muted mb-3 border-bottom pb-2">
                            <i class="bi bi-clock-history me-1"></i> @orden.FechaHora.ToString("hh:mm tt")
                            @if (orden.IdTipoEntregaNavigation != null)
                            {
                                <span class="ms-2 badge bg-secondary">@orden.IdTipoEntregaNavigation.NombreTipo</span>
                            }
                        </p>
                        
                        <ul class="list-group list-group-flush mb-3 shadow-sm rounded">
                            @foreach (var detalle in orden.DetalleOrdens)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-white border-0 border-bottom">
                                    <span class="fw-bold text-dark fs-6">
                                        <span class="badge bg-dark rounded-pill me-2">@detalle.Cantidad</span>
                                        @(detalle.IdProductoNavigation != null ? detalle.IdProductoNavigation.NombreProducto : "Desconocido")
                                    </span>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrEmpty(orden.ObservacionGeneral))
                        {
                            <div class="alert alert-info py-2 small shadow-sm mb-0">
                                <i class="bi bi-info-circle-fill me-1"></i> <strong>Nota:</strong> @orden.ObservacionGeneral
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3 pt-3 text-center">
                        @if (orden.IdEstado == 1)
                        {
                            <form asp-action="ActualizarEstado" method="post">
                                <input type="hidden" name="idOrden" value="@orden.IdOrden" />
                                <input type="hidden" name="nuevoEstado" value="2" /> <!-- Cambia a En Preparación -->
                                <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm text-dark fs-5 py-2">
                                    <i class="bi bi-play-fill me-1"></i> Empezar a Preparar
                                </button>
                            </form>
                        }
                        else if (orden.IdEstado == 2)
                        {
                            <form asp-action="ActualizarEstado" method="post">
                                <input type="hidden" name="idOrden" value="@orden.IdOrden" />
                                <input type="hidden" name="nuevoEstado" value="3" /> <!-- Cambia a Listo -->
                                <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm fs-5 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> Marcar como Listo
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 text-muted mt-5">
            <i class="bi bi-fire fs-1 d-block mb-3" style="color: #ccc;"></i>
            <h4 class="fw-bold">No hay órdenes pendientes</h4>
            <p>La cocina está al día. Las nuevas órdenes aparecerán aquí automáticamente.</p>
        </div>
    }
</div>