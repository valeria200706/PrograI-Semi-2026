@model BumburysRestaurant.Models.Producto
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white py-3" style="background-color: #b30000;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Producto</h5>
            </div>
            <div class="card-body bg-light p-4">
                <form asp-action="Editar">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <!-- Campo oculto necesario para que Entity Framework sepa qué registro actualizar -->
                    <input type="hidden" asp-for="IdProducto" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NombreProducto" class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="NombreProducto" class="form-control shadow-sm" />
                            <span asp-validation-for="NombreProducto" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdCategoria" class="form-label fw-bold">Categoría</label>
                            <select asp-for="IdCategoria" class="form-select shadow-sm" asp-items="ViewBag.Categorias"></select>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="PrecioActual" class="form-label fw-bold">Precio ($)</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="PrecioActual" type="number" step="0.01" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="PrecioActual" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control shadow-sm" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-dark shadow-sm fw-bold px-4">
                            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}