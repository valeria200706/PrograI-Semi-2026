@model BumburysRestaurant.Models.Producto
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 fw-bold">✏ Editar Producto #@Model.IdProducto</h4>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="IdProducto" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="NombreProducto" class="form-label fw-bold">Nombre del Producto *</label>
                    <input asp-for="NombreProducto" class="form-control" required />
                    <span asp-validation-for="NombreProducto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdCategoria" class="form-label fw-bold">Categoría *</label>
                    <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias" required></select>
                    <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioActual" class="form-label fw-bold">Precio ($) *</label>
                    <input asp-for="PrecioActual" type="number" step="0.01" min="0.01" class="form-control" required />
                    <span asp-validation-for="PrecioActual" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold">💾 Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>