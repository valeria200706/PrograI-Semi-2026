@model BumburysRestaurant.Models.Usuario
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 fw-bold">➕ Agregar Nuevo Usuario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo *</label>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. Valeria Solano" required />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label fw-bold">Nombre de Usuario (Login) *</label>
                    <input asp-for="NombreUsuario" class="form-control" placeholder="Ej. vsolano" required />
                    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label fw-bold">Contraseña *</label>
                    <input asp-for="Contrasena" type="password" class="form-control" placeholder="******" required />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdRol" class="form-label fw-bold">Rol Asignado *</label>
                    <select asp-for="IdRol" class="form-select" asp-items="ViewBag.Roles" required>
                        <option value="">-- Seleccione un rol --</option>
                    </select>
                    <span asp-validation-for="IdRol" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold">💾 Guardar Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>