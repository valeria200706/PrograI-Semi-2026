@model BumburysRestaurant.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white py-3" style="background-color: #b30000;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Usuario</h5>
            </div>
            <div class="card-body bg-light p-4">
                <form asp-action="Editar">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <!-- Campos ocultos para mantener el ID y la fecha original -->
                    <input type="hidden" asp-for="IdUsuario" />
                    <input type="hidden" asp-for="FechaCreacion" />
                    
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="NombreCompleto" class="form-control shadow-sm" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NombreUsuario" class="form-label fw-bold">Nombre de Usuario</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                <input asp-for="NombreUsuario" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdRol" class="form-label fw-bold">Rol en el Sistema</label>
                            <select asp-for="IdRol" class="form-select shadow-sm" asp-items="ViewBag.Roles"></select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Contrasena" class="form-label fw-bold">Contraseña</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white"><i class="bi bi-key"></i></span>
                                <input asp-for="Contrasena" type="password" class="form-control border-start-0" value="@Model.Contrasena" />
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Activo" class="form-label fw-bold">Estado</label>
                            <select asp-for="Activo" class="form-select shadow-sm">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                            <span asp-validation-for="Activo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-dark shadow-sm fw-bold px-4">
                            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}