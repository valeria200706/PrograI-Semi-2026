@{
    ViewData["Title"] = "Panel de Control";
}

<!-- Encabezado Ejecutivo -->
<div class="card border-0 shadow-sm mt-4 mb-4 overflow-hidden" style="border-radius: 12px;">
    <div class="card-body p-4 p-md-5 text-white d-flex flex-column flex-md-row justify-content-between align-items-md-center" 
         style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 65%, #8a0000 100%);">
        <div class="mb-3 mb-md-0">
            <span class="badge bg-danger mb-2 px-3 py-1 text-uppercase tracking-wider">Sistema Operativo Interno</span>
            <h1 class="display-6 fw-bold mb-1">Bumbury's Restaurant</h1>
            <p class="text-light opacity-75 mb-0">Control centralizado de comandas, cocina, facturación y catálogo.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-danger btn-lg fw-bold px-4 shadow" asp-controller="Recepcion" asp-action="Index">
                <i class="bi bi-plus-circle me-2"></i> Nuevo Pedido
            </a>
            <a class="btn btn-outline-light btn-lg fw-bold px-4" asp-controller="Cocina" asp-action="Index">
                <i class="bi bi-display me-2"></i> Ver Cocina
            </a>
        </div>
    </div>
</div>

<!-- Tarjetas KPI (Indicadores en Tiempo Real) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important; border-radius: 10px;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <span class="text-muted text-uppercase small fw-bold d-block mb-1">Órdenes en Curso</span>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.OrdenesPendientes</h2>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-fire fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important; border-radius: 10px;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <span class="text-muted text-uppercase small fw-bold d-block mb-1">Ingresos Totales</span>
                    <h2 class="fw-bold mb-0 text-success">$@(((decimal)ViewBag.VentasTotalesDia).ToString("0.00"))</h2>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #212529 !important; border-radius: 10px;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <span class="text-muted text-uppercase small fw-bold d-block mb-1">Platillos Activos</span>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalProductos</h2>
                </div>
                <div class="bg-dark bg-opacity-10 text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #6c757d !important; border-radius: 10px;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <span class="text-muted text-uppercase small fw-bold d-block mb-1">Categorías</span>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalCategorias</h2>
                </div>
                <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-tags fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Accesos Directos Operativos y Administrativos -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <h5 class="fw-bold text-secondary text-uppercase small tracking-wider mb-0">
            <i class="bi bi-grid-1x2-fill me-2 text-danger"></i>Accesos Rápidos por Área
        </h5>
    </div>

    <!-- Operación Diaria -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 10px;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-danger text-white rounded p-2 me-3">
                        <i class="bi bi-shop fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Recepción (POS)</h5>
                </div>
                <p class="text-muted small flex-grow-1">Toma de pedidos en sala o para llevar con carrito interactivo y envío directo a cocina.</p>
                <a asp-controller="Recepcion" asp-action="Index" class="btn btn-outline-danger fw-bold w-100 mt-2">Abrir Punto de Venta</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 10px;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success text-white rounded p-2 me-3">
                        <i class="bi bi-cash-coin fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Caja y Cobros</h5>
                </div>
                <p class="text-muted small flex-grow-1">Facturación de órdenes listas, selección de método de pago y cálculo automático de vuelto.</p>
                <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline-success fw-bold w-100 mt-2">Ir a Caja</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 10px;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-dark text-white rounded p-2 me-3">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Reporte de Ventas</h5>
                </div>
                <p class="text-muted small flex-grow-1">Auditoría financiera de ingresos totales, desglose por efectivo o tarjeta y búsqueda de tickets.</p>
                <a asp-controller="Reportes" asp-action="HistorialVentas" class="btn btn-outline-dark fw-bold w-100 mt-2">Ver Historial</a>
            </div>
        </div>
    </div>

    <!-- Barra inferior rápida para los CRUDs -->
    <div class="col-12">
        <div class="card border-0 shadow-sm bg-white" style="border-radius: 10px;">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-bold text-dark small ms-2"><i class="bi bi-sliders me-2 text-danger"></i>Catálogos del Sistema:</span>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-light border btn-sm fw-semibold px-3">
                        <i class="bi bi-box-seam me-1 text-danger"></i> Productos
                    </a>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-light border btn-sm fw-semibold px-3">
                        <i class="bi bi-tags me-1 text-danger"></i> Categorías
                    </a>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-light border btn-sm fw-semibold px-3">
                        <i class="bi bi-people me-1 text-dark"></i> Usuarios y Roles
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>