@{
    ViewData["Title"] = "Recepción de Pedidos";
}

<div class="row mt-3">
    <!-- Panel Izquierdo: Menú -->
    <div class="col-md-8">
        <!-- Encabezado con Logo -->
        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcREJnh8ymp-B4dsMmkj7CTwtfeSPhq7bg-4wRknxJVIAyEGk3u5RcOB6jvq&s=10" 
                 alt="Logo Bumbury's" 
                 class="me-3 shadow-sm" 
                 style="height: 65px; border-radius: 8px; object-fit: cover;">
            <h2 class="mb-0 fw-bold" style="color: #b30000;">Menú del Restaurante</h2>
        </div>

        <!-- Filtros de Categoría -->
        <div class="mb-4">
            <button class="btn btn-dark me-2 mb-2 px-4 shadow-sm">Todos</button>
            <button class="btn btn-outline-dark me-2 mb-2 px-4 shadow-sm">HAMBURGUESAS</button>
            <button class="btn btn-outline-dark me-2 mb-2 px-4 shadow-sm">ESPECIALIDADES</button>
            <button class="btn btn-outline-dark me-2 mb-2 px-4 shadow-sm">BEBIDAS</button>
            <button class="btn btn-outline-dark me-2 mb-2 px-4 shadow-sm">EXTRAS</button>
        </div>

        <!-- Catálogo de Productos -->
        <div class="row">
            <!-- Tarjeta 1 -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">Bumburys Clásica</h5>
                        <p class="card-text text-muted small flex-grow-1">Hamburguesa tradicional con queso</p>
                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                            <span class="fs-5 fw-bold" style="color: #b30000;">$4.50</span>
                            <button class="btn btn-danger rounded-circle shadow-sm" style="width: 40px; height: 40px;">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tarjeta 2 -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">Bumburys Doble</h5>
                        <p class="card-text text-muted small flex-grow-1">Doble carne y doble queso</p>
                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                            <span class="fs-5 fw-bold" style="color: #b30000;">$8.00</span>
                            <button class="btn btn-danger rounded-circle shadow-sm" style="width: 40px; height: 40px;">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3 -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">Soda</h5>
                        <p class="card-text text-muted small flex-grow-1">Bebida fría 500ml</p>
                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                            <span class="fs-5 fw-bold" style="color: #b30000;">$1.50</span>
                            <button class="btn btn-danger rounded-circle shadow-sm" style="width: 40px; height: 40px;">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Comanda -->
    <div class="col-md-4">
        <div class="card border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="card-header text-white d-flex justify-content-between align-items-center py-3" style="background-color: #212529; border-bottom: 4px solid #b30000;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Comanda de Pedido</h5>
                <button class="btn btn-sm btn-outline-light">Limpiar</button>
            </div>
            <div class="card-body bg-light">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Tipo de Entrega:</label>
                    <select class="form-select shadow-sm border-0">
                        <option>Comer Aquí</option>
                        <option>Llevar</option>
                    </select>
                </div>

                <div class="table-responsive bg-white rounded shadow-sm mb-3">
                    <table class="table table-borderless table-sm text-center mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-2">Producto</th>
                                <th class="py-2">Cant</th>
                                <th class="py-2">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="3" class="text-muted py-4 small">No hay productos agregados</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">Observación General:</label>
                    <input type="text" class="form-control shadow-sm border-0" placeholder="Ej: Entregar con servilletas extra">
                </div>

                <hr class="text-muted">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0 text-dark">Total:</h4>
                    <h4 class="fw-bold mb-0" style="color: #b30000;">$0.00</h4>
                </div>

                <button class="btn btn-success w-100 py-3 fs-5 shadow-sm fw-bold">
                    <i class="bi bi-check2-circle me-2"></i> Confirmar Pedido
                </button>
            </div>
        </div>
    </div>
</div>