@using System.Security.Claims
@model IEnumerable<BumburysRestaurant.Models.Producto>
@{
    ViewData["Title"] = "Toma de Pedidos y Sala";
    var ordenesEnCurso = ViewBag.OrdenesEnCurso as IEnumerable<BumburysRestaurant.Models.Ordene>;
    var mesas = ViewBag.Mesas as IEnumerable<BumburysRestaurant.Models.Mesa>;
    var pedidosWeb = ViewBag.PedidosWeb as IEnumerable<BumburysRestaurant.Models.Ordene>;
    int? mesaPreseleccionada = ViewBag.MesaPreseleccionada as int?;

    string rolActual = User.FindFirstValue(ClaimTypes.Role) ?? "";
    bool esRecepcionOAdmin = rolActual.Equals("Administrador", StringComparison.OrdinalIgnoreCase) ||
                             rolActual.Equals("Recepcion", StringComparison.OrdinalIgnoreCase);
    bool esMesero = rolActual.Equals("Mesero", StringComparison.OrdinalIgnoreCase);
    bool esCajero = rolActual.Equals("Cajero", StringComparison.OrdinalIgnoreCase);
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. BANDEJA DE PEDIDOS WEB ENTRANTES (Siempre visible para Recepción y Admin) -->
@if (esRecepcionOAdmin)
{
    <div class="card border-primary shadow-sm mt-3 mb-3">
        <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
            <span class="fw-bold small">
                <i class="bi bi-globe me-2"></i>Pedidos Web en Línea por Confirmar (@(pedidosWeb?.Count() ?? 0))
            </span>
            <span class="badge bg-white text-primary" style="font-size: 0.7rem;">Recepción Online</span>
        </div>
        <div class="card-body py-2 bg-light">
            @if (pedidosWeb != null && pedidosWeb.Any())
            {
                <div class="row g-2">
                    @foreach (var web in pedidosWeb)
                    {
                        <div class="col-md-4">
                            <div class="bg-white border rounded p-2 shadow-sm d-flex justify-content-between align-items-center">
                                <div class="small">
                                    <strong class="text-primary">Web #@web.IdOrden</strong> - @(web.IdClienteNavigation?.NombreCliente ?? "Cliente Online")<br />
                                    <span class="text-muted">@web.DetalleOrdens.Sum(d => d.Cantidad) prod. &bull; $@web.DetalleOrdens.Sum(d => d.Cantidad * d.PrecioUnitario).ToString("0.00")</span>
                                </div>
                                <form asp-action="AprobarPedidoWeb" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idOrden" value="@web.IdOrden" />
                                    <input type="hidden" name="returnUrl" value="/Recepcion/Index" />
                                    <button type="submit" class="btn btn-sm btn-primary fw-bold">
                                        <i class="bi bi-send-check me-1"></i>A Cocina
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <span class="text-muted small"><i class="bi bi-inbox me-1 text-primary"></i>No hay pedidos web pendientes de aprobación en este momento.</span>
            }
        </div>
    </div>
}

<!-- 2. MAPA DE MESAS EN TIEMPO REAL (Meseros ven disponibilidad; Recepción gestiona estados) -->
@if (!esCajero && mesas != null && mesas.Any())
{
    <div class="card border-0 shadow-sm mt-3 mb-3 bg-white">
        <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center">
            <span class="fw-bold small">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Estado de Mesas en Salón
            </span>
            <div class="small">
                <span class="badge bg-success me-1">Disponible</span>
                <span class="badge bg-danger me-1">Ocupada</span>
                <span class="badge bg-warning text-dark">Sucia / Limpiar</span>
            </div>
        </div>
        <div class="card-body py-2 px-3 bg-light">
            <div class="row g-2">
                @foreach (var m in mesas)
                {
                    string colorCard = m.EstadoMesa switch
                    {
                        "Disponible" => "border-success text-success",
                        "Ocupada" => "border-danger text-danger",
                        _ => "border-warning text-dark bg-warning bg-opacity-10"
                    };
                    string badgeMesa = m.EstadoMesa switch
                    {
                        "Disponible" => "bg-success",
                        "Ocupada" => "bg-danger",
                        _ => "bg-warning text-dark"
                    };

                    <div class="col-6 col-sm-3 col-lg-2">
                        <div class="border border-2 @colorCard rounded bg-white p-2 text-center shadow-sm h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="fw-bold small text-dark">@m.NumeroMesa <span class="text-muted fw-normal">(@m.Capacidad p.)</span></div>
                                <span class="badge @badgeMesa my-1" style="font-size: 0.68rem;">@m.EstadoMesa</span>
                            </div>

                            @if (esRecepcionOAdmin)
                            {
                                <div class="btn-group btn-group-sm mt-1" role="group">
                                    <form asp-action="CambiarEstadoMesa" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idMesa" value="@m.IdMesa" />
                                        <input type="hidden" name="nuevoEstado" value="Disponible" />
                                        <input type="hidden" name="returnUrl" value="/Recepcion/Index" />
                                        <button type="submit" class="btn btn-outline-success py-0 px-1" title="Marcar Disponible"><i class="bi bi-check"></i></button>
                                    </form>
                                    <form asp-action="CambiarEstadoMesa" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idMesa" value="@m.IdMesa" />
                                        <input type="hidden" name="nuevoEstado" value="Ocupada" />
                                        <input type="hidden" name="returnUrl" value="/Recepcion/Index" />
                                        <button type="submit" class="btn btn-outline-danger py-0 px-1" title="Marcar Ocupada"><i class="bi bi-people"></i></button>
                                    </form>
                                    <form asp-action="CambiarEstadoMesa" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idMesa" value="@m.IdMesa" />
                                        <input type="hidden" name="nuevoEstado" value="Sucia" />
                                        <input type="hidden" name="returnUrl" value="/Recepcion/Index" />
                                        <button type="submit" class="btn btn-outline-warning py-0 px-1" title="Marcar Sucia (Limpiar)"><i class="bi bi-stars"></i></button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- 3. MONITOR RÁPIDO DE ÓRDENES EN COCINA (Solo Mesero tiene botón Marcar Servida) -->
<div class="card border-0 shadow-sm mb-3 bg-white">
    <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
        <span class="fw-bold small">
            <i class="bi bi-broadcast text-warning me-2"></i>Monitor de Cocina (Órdenes en Curso y Listas para Servir)
        </span>
        <button type="button" class="btn btn-sm btn-outline-light py-0" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </button>
    </div>
    <div class="card-body py-2 px-3 bg-light">
        @if (ordenesEnCurso != null && ordenesEnCurso.Any())
        {
            <div class="d-flex flex-nowrap overflow-auto gap-2 py-1">
                @foreach (var ord in ordenesEnCurso)
                {
                    bool yaServida = ord.ObservacionGeneral != null && ord.ObservacionGeneral.Contains("[SERVIDA EN MESA]");
                    string badgeColor = ord.IdEstado switch
                    {
                        1 => "bg-warning text-dark",
                        2 => "bg-primary text-white",
                        3 => yaServida ? "bg-info text-dark" : "bg-success text-white",
                        _ => "bg-secondary text-white"
                    };
                    string textoEstado = ord.IdEstado == 3
                        ? (yaServida ? "Servida (Por Cobrar)" : "¡LISTO EN COCINA!")
                        : (ord.IdEstadoNavigation?.NombreEstado ?? "En curso");

                    <div class="border rounded bg-white px-3 py-2 shadow-sm flex-shrink-0" style="min-width: 220px;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark small">
                                Orden #@ord.IdOrden @(ord.IdMesaNavigation != null ? $"• {ord.IdMesaNavigation.NumeroMesa}" : "")
                            </span>
                            <span class="badge @badgeColor" style="font-size: 0.68rem;">@textoEstado</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-person-badge me-1"></i>@(ord.IdUsuarioNavigation?.NombreCompleto ?? "Staff")
                        </div>
                        <div class="text-secondary mb-1" style="font-size: 0.72rem;">
                            <i class="bi bi-bag me-1"></i>@(ord.IdTipoEntregaNavigation?.NombreTipo ?? "Local") &bull; @ord.FechaHora.ToString("hh:mm tt")
                        </div>

                        @if (esMesero && ord.IdEstado == 3 && !yaServida)
                        {
                            <form asp-action="MarcarServida" method="post" class="mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idOrden" value="@ord.IdOrden" />
                                <input type="hidden" name="returnUrl" value="/Recepcion/Index" />
                                <button type="submit" class="btn btn-sm btn-success w-100 py-0 fw-bold" style="font-size: 0.75rem;">
                                    <i class="bi bi-check2-all me-1"></i>Marcar Servida en Mesa
                                </button>
                            </form>
                        }
                        else if (esMesero && ord.IdEstado == 3 && yaServida)
                        {
                            <a asp-controller="Pagos" asp-action="Cobrar" asp-route-id="@ord.IdOrden" class="btn btn-sm btn-outline-dark w-100 py-0 mt-1 fw-bold" style="font-size: 0.75rem;">
                                <i class="bi bi-cash-coin me-1"></i>Cobrar Orden
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <span class="text-muted small"><i class="bi bi-check-circle me-1 text-success"></i>No hay órdenes pendientes en cocina en este momento.</span>
        }
    </div>
</div>

<!-- 4. CATÁLOGO DE MENÚ Y COMANDA -->
<div class="row mt-2">
    <!-- Panel Izquierdo: Menú -->
    <div class="col-md-8">
        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcREJnh8ymp-B4dsMmkj7CTwtfeSPhq7bg-4wRknxJVIAyEGk3u5RcOB6jvq&s=10" 
                 alt="Logo Bumbury's" class="me-3 shadow-sm" style="height: 60px; border-radius: 8px; object-fit: cover;">
            <div>
                <h2 class="mb-0 fw-bold" style="color: #b30000;">Menú del Restaurante</h2>
                <small class="text-muted">Atendiendo: <strong>@User.Identity?.Name</strong> (@rolActual)</small>
            </div>
        </div>

        <!-- Filtros de Categoría -->
        <div class="mb-4" id="contenedor-filtros">
            <button class="btn btn-dark me-2 mb-2 px-4 shadow-sm btn-filtro" data-id="0">Todos</button>
            @if (ViewBag.Categorias != null)
            {
                foreach (var cat in ViewBag.Categorias)
                {
                    <button class="btn btn-outline-dark me-2 mb-2 px-4 shadow-sm btn-filtro" data-id="@cat.IdCategoria">
                        @cat.NombreCategoria.ToUpper()
                    </button>
                }
            }
        </div>

        <!-- Catálogo de Productos -->
        <div class="row" id="catalogo-productos">
            @if (Model != null && Model.Any())
            {
                foreach (var prod in Model)
                {
                    <div class="col-md-4 mb-4 tarjeta-producto" data-categoria="@prod.IdCategoria">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">@prod.NombreProducto</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(string.IsNullOrEmpty(prod.Descripcion) ? "Sin descripción" : prod.Descripcion)
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                                    <span class="fs-5 fw-bold" style="color: #b30000;">$@prod.PrecioActual.ToString("0.00")</span>
                                    <button class="btn btn-danger rounded-circle shadow-sm btn-agregar" 
                                            data-id="@prod.IdProducto" 
                                            data-nombre="@prod.NombreProducto" 
                                            data-precio="@prod.PrecioActual.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            style="width: 40px; height: 40px;">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
                    No hay productos disponibles en este momento.
                </div>
            }
        </div>
    </div>

    <!-- Panel Derecho: Comanda -->
    <div class="col-md-4">
        <div class="card border-0 shadow-lg" style="border-radius: 12px; overflow: hidden; position: sticky; top: 20px;">
            <div class="card-header text-white d-flex justify-content-between align-items-center py-3" style="background-color: #212529; border-bottom: 4px solid #b30000;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Comanda de Pedido</h5>
                <button class="btn btn-sm btn-outline-light" id="btn-limpiar">Limpiar</button>
            </div>
            <div class="card-body bg-light">
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small text-secondary">Modalidad:</label>
                        <select class="form-select shadow-sm border-0" id="tipo-entrega">
                            @if (ViewBag.TiposEntrega != null)
                            {
                                foreach (var tipo in ViewBag.TiposEntrega)
                                {
                                    bool esParaLlevar = tipo.NombreTipo.ToString().Contains("Llevar", StringComparison.OrdinalIgnoreCase);
                                    <option value="@tipo.IdTipoEntrega" selected="@(esCajero && esParaLlevar)">@tipo.NombreTipo</option> 
                                }
                            }
                            else
                            {
                                <option value="1">Comer Aquí</option>
                                <option value="2" selected="@esCajero">Para Llevar</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small text-secondary">Mesa (Salón):</label>
                        <select class="form-select shadow-sm border-0" id="mesa-seleccionada">
                            <option value="0">-- Sin Mesa / Llevar --</option>
                            @if (mesas != null)
                            {
                                foreach (var m in mesas.Where(x => x.EstadoMesa == "Disponible"))
                                {
                                    <option value="@m.IdMesa" selected="@(mesaPreseleccionada == m.IdMesa)">@m.NumeroMesa (@m.Capacidad p.)</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Tabla del Carrito -->
                <div class="table-responsive bg-white rounded shadow-sm mb-3" style="max-height: 230px; overflow-y: auto;">
                    <table class="table table-borderless table-sm text-center mb-0">
                        <thead class="table-light border-bottom sticky-top">
                            <tr>
                                <th class="py-2 text-start px-3">Producto</th>
                                <th class="py-2">Cant</th>
                                <th class="py-2 text-end px-3">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpo-comanda">
                            <tr>
                                <td colspan="3" class="text-muted py-4 small">No hay productos agregados</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">Observación / Nombre Cliente:</label>
                    <input type="text" id="observacion-general" class="form-control shadow-sm border-0" placeholder="Ej: Sin cebolla / Cliente Juan">
                </div>

                <hr class="text-muted">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0 text-dark">Total:</h4>
                    <h4 class="fw-bold mb-0" id="total-comanda" style="color: #b30000;">$0.00</h4>
                </div>

                <button class="btn btn-success w-100 py-3 fs-5 shadow-sm fw-bold" id="btn-confirmar">
                    <i class="bi bi-check2-circle me-2"></i> Confirmar Pedido
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let comanda = [];

        document.querySelectorAll('.btn-filtro').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.btn-filtro').forEach(b => {
                    b.classList.remove('btn-dark');
                    b.classList.add('btn-outline-dark');
                });
                this.classList.remove('btn-outline-dark');
                this.classList.add('btn-dark');

                let catId = this.getAttribute('data-id');
                document.querySelectorAll('.tarjeta-producto').forEach(tarjeta => {
                    if (catId === "0" || tarjeta.getAttribute('data-categoria') === catId) {
                        tarjeta.style.display = 'block';
                    } else {
                        tarjeta.style.display = 'none';
                    }
                });
            });
        });

        document.querySelectorAll('.btn-agregar').forEach(btn => {
            btn.addEventListener('click', function() {
                let id = this.getAttribute('data-id');
                let nombre = this.getAttribute('data-nombre');
                let precio = parseFloat(this.getAttribute('data-precio'));

                let index = comanda.findIndex(p => p.IdProducto === id);
                if (index !== -1) {
                    comanda[index].Cantidad++;
                } else {
                    comanda.push({ IdProducto: id, Nombre: nombre, Precio: precio, Cantidad: 1 });
                }
                actualizarInterfaz();
            });
        });

        function actualizarInterfaz() {
            let tbody = document.getElementById('cuerpo-comanda');
            let totalEl = document.getElementById('total-comanda');
            tbody.innerHTML = '';
            let total = 0;

            if (comanda.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-muted py-4 small">No hay productos agregados</td></tr>';
                totalEl.innerText = '$0.00';
                return;
            }

            comanda.forEach((item, index) => {
                let subtotal = item.Precio * item.Cantidad;
                total += subtotal;
                
                tbody.innerHTML += `
                    <tr class="align-middle border-bottom">
                        <td class="text-start px-3 small fw-bold text-dark">${item.Nombre}</td>
                        <td style="min-width: 80px;">
                            <div class="d-flex justify-content-center align-items-center">
                                <button class="btn btn-sm btn-light border p-0 rounded-circle text-danger fw-bold" style="width: 25px; height: 25px;" onclick="cambiarCantidad(${index}, -1)">-</button>
                                <span class="mx-2 fw-bold">${item.Cantidad}</span>
                                <button class="btn btn-sm btn-light border p-0 rounded-circle text-success fw-bold" style="width: 25px; height: 25px;" onclick="cambiarCantidad(${index}, 1)">+</button>
                            </div>
                        </td>
                        <td class="text-end px-3 fw-bold text-success">$${subtotal.toFixed(2)}</td>
                    </tr>
                `;
            });
            totalEl.innerText = `$${total.toFixed(2)}`;
        }

        window.cambiarCantidad = function(index, delta) {
            comanda[index].Cantidad += delta;
            if (comanda[index].Cantidad <= 0) {
                comanda.splice(index, 1);
            }
            actualizarInterfaz();
        }

        document.getElementById('btn-limpiar').addEventListener('click', () => {
            comanda = [];
            document.getElementById('observacion-general').value = '';
            document.getElementById('mesa-seleccionada').value = '0';
            actualizarInterfaz();
        });

        document.getElementById('btn-confirmar').addEventListener('click', async () => {
            if (comanda.length === 0) {
                alert('La comanda está vacía. Selecciona productos del menú.');
                return;
            }

            let idMesaVal = parseInt(document.getElementById('mesa-seleccionada').value) || 0;

            let payload = {
                IdTipoEntrega: parseInt(document.getElementById('tipo-entrega').value) || 1,
                IdMesa: idMesaVal > 0 ? idMesaVal : null,
                ObservacionGeneral: document.getElementById('observacion-general').value,
                Detalles: comanda.map(p => ({
                    IdProducto: parseInt(p.IdProducto),
                    Cantidad: p.Cantidad,
                    Indicacion: "" 
                }))
            };

            let btnConfirmar = document.getElementById('btn-confirmar');
            btnConfirmar.disabled = true;
            btnConfirmar.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Procesando...';

            try {
                let response = await fetch('/Recepcion/GuardarOrden', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                let data = await response.json();

                if (response.ok && data.exito) {
                    alert('¡Pedido exitoso! Se ha generado la Orden #' + data.idOrden);
                    location.reload();
                } else {
                    alert(data.mensaje || 'Error desconocido al guardar la orden.');
                }
            } catch (error) {
                console.error("Error al conectar con servidor: ", error);
                alert('Hubo un error de conexión al enviar el pedido.');
            } finally {
                btnConfirmar.disabled = false;
                btnConfirmar.innerHTML = '<i class="bi bi-check2-circle me-2"></i> Confirmar Pedido';
            }
        });
    </script>
}