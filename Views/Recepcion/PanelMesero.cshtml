@model IEnumerable<BumburysRestaurant.Models.Ordene>
@{
    ViewData["Title"] = "Panel del Mesero";
    var mesas = ViewBag.Mesas as IEnumerable<BumburysRestaurant.Models.Mesa>;
    int disponibles = mesas?.Count(m => m.EstadoMesa == "Disponible") ?? 0;
    int listasParaServir = Model.Count(o => o.IdEstado == 3 && (o.ObservacionGeneral == null || !o.ObservacionGeneral.Contains("[SERVIDA EN MESA]")));
    int listasParaCobrar = Model.Count(o => o.IdEstado == 3);
}

<div class="container-fluid py-3">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Encabezado de Bienvenida -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0" style="color: #b30000;"><i class="bi bi-person-badge-fill me-2"></i>Panel de Atención - Mesero</h2>
            <p class="text-muted mb-0">Bienvenido(a), <strong>@User.Identity?.Name</strong></p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-controller="Recepcion" asp-action="Index" class="btn btn-danger fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Pedido
            </a>
            <a asp-controller="Pagos" asp-action="Index" class="btn btn-success fw-bold shadow-sm">
                <i class="bi bi-cash-coin me-1"></i> Mis Cobros (@listasParaCobrar)
            </a>
        </div>
    </div>

    <!-- Tarjetas KPI del Mesero -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold opacity-75">Mesas Disponibles</div>
                    <h2 class="fw-bold mb-0">@disponibles / @(mesas?.Count() ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold opacity-75">Listas en Cocina</div>
                    <h2 class="fw-bold mb-0">@listasParaServir</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold opacity-75">Mis Mesas por Cobrar</div>
                    <h2 class="fw-bold mb-0">@listasParaCobrar</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white h-100">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold opacity-75">Atendidas Hoy</div>
                    <h2 class="fw-bold mb-0">@ViewBag.MisOrdenesCobradasHoy</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Mapa de Mesas (Tocar mesa disponible abre comanda) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap me-2"></i>Disponibilidad de Mesas</h5>
                    <small class="text-light opacity-75">Toca una mesa libre para tomar orden</small>
                </div>
                <div class="card-body bg-light">
                    <div class="row g-3">
                        @if (mesas != null && mesas.Any())
                        {
                            foreach (var m in mesas)
                            {
                                bool libre = m.EstadoMesa == "Disponible";
                                string borde = libre ? "border-success" : (m.EstadoMesa == "Ocupada" ? "border-danger" : "border-warning");
                                string badge = libre ? "bg-success" : (m.EstadoMesa == "Ocupada" ? "bg-danger" : "bg-warning text-dark");

                                <div class="col-6 col-sm-4">
                                    <div class="card border-2 @borde shadow-sm text-center h-100">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <h5 class="fw-bold mb-1">@m.NumeroMesa</h5>
                                                <div class="text-muted small mb-2"><i class="bi bi-people me-1"></i>@m.Capacidad personas</div>
                                                <span class="badge @badge mb-2">@m.EstadoMesa</span>
                                            </div>
                                            @if (libre)
                                            {
                                                <a asp-controller="Recepcion" asp-action="Index" asp-route-idMesaPreseleccionada="@m.IdMesa" class="btn btn-sm btn-outline-success fw-bold w-100 mt-1">
                                                    Tomar Orden
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light text-muted w-100 mt-1" disabled>No disponible</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Mis Pedidos Activos (Marcar Servida o Cobrar) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-bell-fill text-warning me-2"></i>Mis Órdenes en Curso</h5>
                    <button type="button" class="btn btn-sm btn-outline-light" onclick="location.reload()">
                        <i class="bi bi-arrow-clockwise"></i> Actualizar
                    </button>
                </div>
                <div class="card-body bg-light">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ord in Model)
                        {
                            bool yaServida = ord.ObservacionGeneral != null && ord.ObservacionGeneral.Contains("[SERVIDA EN MESA]");
                            decimal total = ord.DetalleOrdens.Sum(d => d.Cantidad * d.PrecioUnitario);

                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <span class="fw-bold fs-6 text-dark">Orden #@ord.IdOrden</span>
                                        @if (ord.IdMesaNavigation != null)
                                        {
                                            <span class="badge bg-dark ms-1">@ord.IdMesaNavigation.NumeroMesa</span>
                                        }
                                        <div class="small text-muted mt-1">
                                            Total: <strong class="text-success">$@total.ToString("0.00")</strong> &bull; @ord.FechaHora.ToString("hh:mm tt")
                                        </div>
                                        @if (yaServida)
                                        {
                                            <span class="badge bg-info text-dark mt-1"><i class="bi bi-check2-all me-1"></i>Servida en Mesa</span>
                                        }
                                        else if (ord.IdEstado == 3)
                                        {
                                            <span class="badge bg-success mt-1"><i class="bi bi-fire me-1"></i>¡Lista en Cocina!</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark mt-1">@(ord.IdEstadoNavigation?.NombreEstado ?? "En Cocina")</span>
                                        }
                                    </div>

                                    <div class="d-flex gap-2">
                                        @if (ord.IdEstado == 3 && !yaServida)
                                        {
                                            <form asp-controller="Recepcion" asp-action="MarcarServida" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idOrden" value="@ord.IdOrden" />
                                                <input type="hidden" name="returnUrl" value="/Recepcion/PanelMesero" />
                                                <button type="submit" class="btn btn-success fw-bold btn-sm px-3">
                                                    <i class="bi bi-check2-circle me-1"></i>✓ Servida en Mesa
                                                </button>
                                            </form>
                                        }
                                        @if (ord.IdEstado == 3)
                                        {
                                            <a asp-controller="Pagos" asp-action="Cobrar" asp-route-id="@ord.IdOrden" class="btn btn-dark fw-bold btn-sm px-3">
                                                <i class="bi bi-cash-coin me-1"></i>Cobrar
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-cup-hot fs-1 d-block mb-2"></i>
                            No tienes órdenes activas en este momento.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>