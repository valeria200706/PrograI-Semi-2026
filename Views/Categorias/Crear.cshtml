@model BumburysRestaurant.Models.Categoria
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 fw-bold">➕ Agregar Nueva Categoría</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="NombreCategoria" class="form-label fw-bold">Nombre de la Categoría *</label>
                    <input asp-for="NombreCategoria" class="form-control" placeholder="Ej. HAMBURGUESAS, BEBIDAS, EXTRAS" required />
                    <span asp-validation-for="NombreCategoria" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción breve de la categoría..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold">💾 Guardar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>