@model IEnumerable<BumburysRestaurant.Models.Ordene>
@{
    ViewData["Title"] = "Caja y Facturación";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mt-4">
    <div class="card-header text-white d-flex justify-content-between align-items-center py-3" style="background-color: #b30000;">
        <h4 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2"></i> Órdenes Listas para Cobro</h4>
    </div>
    
    <div class="card-body bg-light">
        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>N° Orden</th>
                        <th>Hora</th>
                        <th>Tipo Entrega</th>
                        <th>Total Calculado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var orden in Model)
                        {
                            decimal total = orden.DetalleOrdens.Sum(d => d.Cantidad * d.PrecioUnitario);
                            <tr>
                                <td class="fw-bold fs-5">#@orden.IdOrden</td>
                                <td>@orden.FechaHora.ToString("hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @(orden.IdTipoEntregaNavigation != null ? orden.IdTipoEntregaNavigation.NombreTipo : "N/A")
                                    </span>
                                </td>
                                <td class="fw-bold text-success fs-5">$@total.ToString("0.00")</td>
                                <td class="text-center">
                                    <a asp-action="Cobrar" asp-route-id="@orden.IdOrden" class="btn btn-success fw-bold shadow-sm px-4">
                                        <i class="bi bi-wallet2 me-1"></i> Cobrar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-all fs-1 d-block mb-2"></i>
                                No hay órdenes pendientes de cobro.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>