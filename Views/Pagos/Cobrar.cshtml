@model BumburysRestaurant.Models.Ordene
@{
    ViewData["Title"] = "Procesar Pago";
    decimal total = Model.DetalleOrdens.Sum(d => d.Cantidad * d.PrecioUnitario);
}

<div class="row mt-4">
    <!-- Resumen de la Orden -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Detalle de Orden #@Model.IdOrden</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Producto</th>
                            <th>Cant</th>
                            <th>Precio</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DetalleOrdens)
                        {
                            decimal subtotal = item.Cantidad * item.PrecioUnitario;
                            <tr class="align-middle">
                                <td class="text-start fw-bold">@(item.IdProductoNavigation != null ? item.IdProductoNavigation.NombreProducto : "Producto")</td>
                                <td>@item.Cantidad</td>
                                <td>$@item.PrecioUnitario.ToString("0.00")</td>
                                <td class="text-end text-success fw-bold">$@subtotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="fw-bold mb-0 text-dark">TOTAL A PAGAR:</h3>
                    <h2 class="fw-bold mb-0" style="color: #b30000;" id="monto-total" data-total="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)">$@total.ToString("0.00")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario de Pago -->
    <div class="col-md-5">
        <div class="card border-0 shadow-lg h-100">
            <div class="card-header text-white py-3" style="background-color: #b30000;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-credit-card me-2"></i>Facturación</h5>
            </div>
            <div class="card-body bg-light">
                
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger small shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["Error"]</div>
                }

                <form asp-action="ProcesarPago" method="post">
                    <input type="hidden" name="IdOrden" value="@Model.IdOrden" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Método de Pago:</label>
                        <select name="IdMetodoPago" class="form-select shadow-sm" asp-items="ViewBag.MetodosPago" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Monto Recibido ($):</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0 text-success fw-bold">$</span>
                            <input type="number" step="0.01" min="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)" name="MontoRecibido" id="monto-recibido" class="form-control border-start-0 fs-5 fw-bold" required placeholder="0.00">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Referencia (Opcional):</label>
                        <input type="text" name="ReferenciaPago" class="form-control shadow-sm" placeholder="N° de Transferencia / Últimos 4 tarjeta">
                    </div>

                    <div class="p-3 mb-4 rounded shadow-sm" style="background-color: #e9ecef;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-secondary">Cambio a devolver:</h5>
                            <h4 class="mb-0 fw-bold text-success" id="cambio-visual">$0.00</h4>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Cancelar</a>
                        <button type="submit" class="btn btn-success fw-bold shadow-sm px-4 py-2 fs-5">
                            <i class="bi bi-check-circle-fill me-2"></i> Registrar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('monto-recibido').addEventListener('input', function() {
            let total = parseFloat(document.getElementById('monto-total').getAttribute('data-total'));
            let recibido = parseFloat(this.value);
            let cambioVisual = document.getElementById('cambio-visual');

            if (!isNaN(recibido) && recibido >= total) {
                let cambio = recibido - total;
                cambioVisual.innerText = '$' + cambio.toFixed(2);
                cambioVisual.classList.replace('text-secondary', 'text-success');
                cambioVisual.classList.replace('text-danger', 'text-success');
            } else {
                cambioVisual.innerText = 'Monto insuficiente';
                cambioVisual.classList.replace('text-success', 'text-danger');
            }
        });
    </script>
}