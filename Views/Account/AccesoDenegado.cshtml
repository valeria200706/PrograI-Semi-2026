@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container text-center py-5 mt-4">
    <div class="card border-0 shadow-sm mx-auto p-5" style="max-width: 500px; border-radius: 12px;">
        <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
        <h3 class="fw-bold text-dark">Acceso Restringido</h3>
        <p class="text-muted">Tu rol actual (<strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>) no tiene permisos para visualizar este módulo.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark fw-bold px-4 mt-2">
            <i class="bi bi-arrow-left me-1"></i> Volver a mi Área
        </a>
    </div>
</div>