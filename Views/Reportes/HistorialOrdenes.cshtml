@model IEnumerable<BumburysRestaurant.Models.Ordene>
@{
    ViewData["Title"] = "Historial de Pedidos";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="mb-0 fw-bold" style="color: #b30000;"><i class="bi bi-journal-text me-2"></i>Historial General de Pedidos</h2>
</div>

<!-- Tarjetas Resumen -->
<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">Total Órdenes</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalOrdenes</h3>
                </div>
                <i class="bi bi-receipt fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">En Proceso (Cocina)</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.Pendientes</h3>
                </div>
                <i class="bi bi-fire fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">Finalizadas / Cobradas</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.Completadas</h3>
                </div>
                <i class="bi bi-check2-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2"></i>Todas las Órdenes Registradas</h5>
    </div>
    <div class="card-body bg-light">
        <!-- Filtros -->
        <form asp-action="HistorialOrdenes" method="get" class="row g-2 mb-4">
            <div class="col-md-5">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.BuscarActual" class="form-control border-start-0" placeholder="Buscar por N° Orden, mesero u observación...">
                </div>
            </div>
            <div class="col-md-4">
                <select name="idEstado" class="form-select shadow-sm">
                    <option value="0">-- Todos los estados --</option>
                    <option value="1" selected="@(ViewBag.EstadoActual == 1)">1 - Pendiente</option>
                    <option value="2" selected="@(ViewBag.EstadoActual == 2)">2 - En Preparación</option>
                    <option value="3" selected="@(ViewBag.EstadoActual == 3)">3 - Lista para Cobro</option>
                    <option value="4" selected="@(ViewBag.EstadoActual == 4)">4 - Entregada / Pagada</option>
                    <option value="5" selected="@(ViewBag.EstadoActual == 5)">5 - Cancelada</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-danger fw-bold w-100 shadow-sm">Filtrar</button>
                <a asp-action="HistorialOrdenes" class="btn btn-outline-secondary shadow-sm">Limpiar</a>
            </div>
        </form>

        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>N° Orden</th>
                        <th>Fecha y Hora</th>
                        <th>Atendido por</th>
                        <th>Modalidad</th>
                        <th>Productos</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var orden in Model)
                        {
                            decimal total = orden.DetalleOrdens.Sum(d => d.Cantidad * d.PrecioUnitario);
                            string badgeColor = orden.IdEstado switch
                            {
                                1 => "bg-danger",
                                2 => "bg-warning text-dark",
                                3 => "bg-info text-dark",
                                4 => "bg-success",
                                _ => "bg-secondary"
                            };
                            string nombreEstado = orden.IdEstadoNavigation != null ? orden.IdEstadoNavigation.NombreEstado : $"Estado {orden.IdEstado}";

                            <tr>
                                <td class="fw-bold fs-6">#@orden.IdOrden</td>
                                <td class="small">@orden.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td class="small fw-semibold text-dark">
                                    <i class="bi bi-person-badge text-danger me-1"></i>@(orden.IdUsuarioNavigation?.NombreCompleto ?? "Sistema")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(orden.IdTipoEntregaNavigation != null ? orden.IdTipoEntregaNavigation.NombreTipo : "N/A")
                                    </span>
                                </td>
                                <td class="small">
                                    @foreach (var det in orden.DetalleOrdens)
                                    {
                                        <div><span class="fw-bold">@det.Cantidad x</span> @(det.IdProductoNavigation?.NombreProducto ?? "Producto")</div>
                                    }
                                </td>
                                <td class="fw-bold text-success">$@total.ToString("0.00")</td>
                                <td><span class="badge @badgeColor">@nombreEstado</span></td>
                                <td class="text-center">
                                    @if (orden.IdEstado == 1 || orden.IdEstado == 2 || orden.IdEstado == 3)
                                    {
                                        <form asp-action="CancelarOrden" method="post" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas cancelar la Orden #@orden.IdOrden?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idOrden" value="@orden.IdOrden" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar Orden">
                                                <i class="bi bi-x-circle"></i> Anular
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-lock-fill"></i> Cerrada</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No se encontraron pedidos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>