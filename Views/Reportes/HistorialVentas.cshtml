@model IEnumerable<BumburysRestaurant.Models.PagosVenta>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="mb-0 fw-bold" style="color: #b30000;"><i class="bi bi-graph-up-arrow me-2"></i>Historial de Ventas</h2>
    <button onclick="window.print()" class="btn btn-dark shadow-sm px-4"><i class="bi bi-printer me-2"></i>Imprimir Reporte</button>
</div>

<!-- Tarjetas de Resumen Financiero -->
<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">Ingresos Totales</h6>
                    <h3 class="fw-bold mb-0">$@(((decimal)ViewBag.TotalIngresos).ToString("0.00"))</h3>
                </div>
                <i class="bi bi-cash-stack fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">Ventas en Tarjeta</h6>
                    <h3 class="fw-bold mb-0">$@(((decimal)ViewBag.TotalTarjeta).ToString("0.00"))</h3>
                </div>
                <i class="bi bi-credit-card fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm text-white h-100" style="background-color: #20c997;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="text-uppercase fw-bold mb-1 opacity-75">Ventas en Efectivo</h6>
                    <h3 class="fw-bold mb-0">$@(((decimal)ViewBag.TotalEfectivo).ToString("0.00"))</h3>
                </div>
                <i class="bi bi-wallet2 fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Registro Detallado de Pagos</h5>
    </div>
    
    <div class="card-body bg-light">
        <!-- Buscador -->
        <form asp-action="HistorialVentas" method="get" class="mb-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="buscar" value="@ViewBag.BuscarActual" class="form-control border-start-0" placeholder="Buscar por N° Orden o Referencia...">
                        <button type="submit" class="btn btn-secondary px-4">Filtrar</button>
                        <a asp-action="HistorialVentas" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </div>
            </div>
        </form>

        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th>ID Pago</th>
                        <th>N° Orden</th>
                        <th>Fecha y Hora</th>
                        <th>Método de Pago</th>
                        <th>Referencia</th>
                        <th class="text-end">Monto Cobrado</th>
                        <th class="text-center">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pago in Model)
                        {
                            <tr>
                                <td class="text-muted small">#@pago.IdPago</td>
                                <td class="fw-bold fs-6">
                                    <span class="badge bg-dark">Orden #@pago.IdOrden</span>
                                </td>
                                <td>@pago.FechaHoraPago.ToString("dd/MM/yyyy - hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @(pago.IdMetodoPagoNavigation != null ? pago.IdMetodoPagoNavigation.NombreMetodo : "Desconocido")
                                    </span>
                                </td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(pago.ReferenciaPago) ? "N/A" : pago.ReferenciaPago)</td>
                                <td class="text-end fw-bold text-success fs-5">$@pago.MontoAplicado.ToString("0.00")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalTicket-@pago.IdPago">
                                        <i class="bi bi-receipt me-1"></i> Ver Ticket
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No se encontraron pagos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modales de Ticket Detallado por cada Venta -->
@if (Model != null && Model.Any())
{
    foreach (var pago in Model)
    {
        var orden = pago.IdOrdenNavigation;
        decimal cambio = pago.MontoRecibido - pago.MontoAplicado;
        if (cambio < 0) cambio = 0;

        <div class="modal fade" id="modalTicket-@pago.IdPago" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header text-white" style="background-color: #b30000;">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-receipt-cutoff me-2"></i>Ticket de Venta - Orden #@pago.IdOrden
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex justify-content-between text-muted small mb-3 border-bottom pb-2">
                            <div>
                                <strong>Fecha Pago:</strong> @pago.FechaHoraPago.ToString("dd/MM/yyyy hh:mm tt")<br />
                                <strong>Modalidad:</strong> @(orden?.IdTipoEntregaNavigation?.NombreTipo ?? "N/A")
                            </div>
                            <div class="text-end">
                                <strong>Pago #@pago.IdPago</strong><br />
                                <strong>Método:</strong> @(pago.IdMetodoPagoNavigation?.NombreMetodo ?? "N/A")
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(orden?.ObservacionGeneral))
                        {
                            <div class="alert alert-warning py-2 small mb-3">
                                <i class="bi bi-chat-left-text me-1"></i> <strong>Nota:</strong> @orden.ObservacionGeneral
                            </div>
                        }

                        <h6 class="fw-bold text-uppercase small text-secondary mb-2">Detalle de Productos Comprados</h6>
                        <table class="table table-sm table-borderless border-bottom mb-3">
                            <thead class="table-light border-bottom">
                                <tr class="small text-muted">
                                    <th>Cant.</th>
                                    <th>Producto</th>
                                    <th class="text-end">P. Unit</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (orden?.DetalleOrdens != null && orden.DetalleOrdens.Any())
                                {
                                    foreach (var item in orden.DetalleOrdens)
                                    {
                                        decimal sub = item.Cantidad * item.PrecioUnitario;
                                        <tr>
                                            <td class="fw-bold">@item.Cantidad</td>
                                            <td>@(item.IdProductoNavigation?.NombreProducto ?? "Producto")</td>
                                            <td class="text-end text-muted">$@item.PrecioUnitario.ToString("0.00")</td>
                                            <td class="text-end fw-semibold">$@sub.ToString("0.00")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted small">Sin detalle de productos registrado.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="bg-light p-3 rounded">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Total Orden:</span>
                                <span class="fw-bold fs-5 text-dark">$@pago.MontoAplicado.ToString("0.00")</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Monto Recibido:</span>
                               <span>$@pago.MontoRecibido.ToString("0.00")</span>
                            </div>
                            <div class="d-flex justify-content-between small text-success fw-bold">
                                <span>Cambio Devuelto:</span>
                                <span>$@cambio.ToString("0.00")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(pago.ReferenciaPago))
                            {
                                <div class="d-flex justify-content-between small text-muted mt-2 pt-2 border-top">
                                    <span>Referencia:</span>
                                    <span>@pago.ReferenciaPago</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}