@model BumburysRestaurant.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 fw-bold">✏ Editar Usuario #@Model.IdUsuario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="IdUsuario" />
                <input type="hidden" asp-for="FechaCreacion" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo *</label>
                    <input asp-for="NombreCompleto" class="form-control" required />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label fw-bold">Nombre de Usuario *</label>
                    <input asp-for="NombreUsuario" class="form-control" required />
                    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label fw-bold">Contraseña *</label>
                    <input asp-for="Contrasena" type="password" class="form-control" required />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdRol" class="form-label fw-bold">Rol Asignado *</label>
                    <select asp-for="IdRol" class="form-select" asp-items="ViewBag.Roles" required></select>
                    <span asp-validation-for="IdRol" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" id="checkActivo" />
                    <label class="form-check-label fw-bold" for="checkActivo">Usuario Activo</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold">💾 Actualizar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>